# Environment file for production deployment
# Copy this file to .env and update the values for your production environment

# Database Configuration
POSTGRES_DB=benha_scooters
POSTGRES_USER=your_production_user
POSTGRES_PASSWORD=your_secure_production_password
DB_HOST=postgres  # Change to your RDS endpoint for AWS deployment
DB_PORT=5432

# JWT Configuration - CHANGE THESE FOR PRODUCTION
JWT_SIGNING_KEY=your_very_secure_jwt_signing_key_at_least_32_characters_long
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=300
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# MinIO/S3 Configuration
MINIO_ROOT_USER=your_minio_admin_user
MINIO_ROOT_PASSWORD=your_secure_minio_password
S3_SERVICE_URL=http://minio:9000  # Change to your S3 endpoint for AWS
S3_BUCKET_NAME=benha-scooters-prod
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_FORCE_PATH_STYLE=true  # Set to false for AWS S3

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# Token Cleanup
TOKEN_CLEANUP_INTERVAL_HOURS=1

# Ports
API_PORT=5000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
